{
	"name": "Append_Mapping_ApplicantFlow",
	"properties": {
		"folder": {
			"name": "Client/Database/Load Mapping Tables"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Source_Mapping_Applicant",
						"type": "DatasetReference"
					},
					"name": "ApplicantFlowMapping"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "etalentApplFlowMapTbl",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "alterRow1"
				},
				{
					"name": "AlterColumnNamesforMap"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {Client ID} as string,",
				"          {Client Engagement Date} as date 'MM/dd/yyyy',",
				"          {Client Applicant Final Disposition} as string,",
				"          {Client Applicant Step Before Final Disposition} as string,",
				"          {Client Applicant Rejected Reason} as string,",
				"          {Client Qualified Ind} as string,",
				"          {Client Submitted to HM Ind} as string,",
				"          {Client Interviewed Ind} as string,",
				"          {Client Offer Extended Ind} as string,",
				"          {Client Hired Ind} as string,",
				"          {Elloree Applicant Final Disposition} as string,",
				"          {Elloree Applicant Category} as string,",
				"          {Elloree Submitted to Mgr Fl} as string,",
				"          {Elloree Qualified Ind} as string,",
				"          {Elloree Submitted to HM Ind} as string,",
				"          {Elloree Interviewed Ind} as string,",
				"          {Elloree Offer Extended Ind} as string,",
				"          {Elloree Hired Ind} as string,",
				"          {Elloree Highest Stage} as string,",
				"          {Elloree Exit Stage Group} as string,",
				"          {Elloree Exit Type} as string,",
				"          {Elloree Exit Driver} as string,",
				"          {Elloree Exit Driver Group} as string,",
				"          {Suggested Elloree Qualified Ind} as string,",
				"          {Suggested Elloree Submitted to HM Ind} as string,",
				"          {Suggested Elloree Interviewed Ind} as string,",
				"          {Suggested Elloree Offer Extended Ind} as string,",
				"          {Suggested Elloree Hired Ind} as string,",
				"          {Suggested Elloree Highest Stage} as string,",
				"          {Suggested Elloree Exit Stage Group} as string,",
				"          {Suggested Elloree Exit Type} as string,",
				"          {Suggested Elloree Exit Driver} as string,",
				"          {Suggested Elloree Exit Driver Group} as string,",
				"          {Suggested Source} as string,",
				"          {2025 Job Applicant} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ApplicantFlowMapping",
				"ApplicantFlowMapping alterRow(upsertIf(true()),",
				"     deleteIf(isNull({Client ID})),",
				"     deleteIf(isNull({Client Engagement Date})),",
				"     deleteIf(isNull({Client Applicant Final Disposition})),",
				"     deleteIf(isNull({Client Applicant Step Before Final Disposition})),",
				"     deleteIf(isNull({Client Applicant Rejected Reason})),",
				"     deleteIf(isNull({Elloree Applicant Final Disposition})),",
				"     deleteIf(isNull({Elloree Applicant Category})),",
				"     deleteIf(isNull({Elloree Submitted to Mgr Fl})),",
				"     deleteIf(isNull({Elloree Submitted to Mgr Fl})),",
				"     deleteIf(isNull({Client Qualified Ind})),",
				"     deleteIf(isNull({Client Submitted to HM Ind})),",
				"     deleteIf(isNull({Client Interviewed Ind})),",
				"     deleteIf(isNull({Client Offer Extended Ind})),",
				"     deleteIf(isNull({Client Hired Ind})),",
				"     deleteIf(isNull({Elloree Qualified Ind})),",
				"     deleteIf(isNull({Elloree Submitted to HM Ind})),",
				"     deleteIf(isNull({Elloree Interviewed Ind})),",
				"     deleteIf(isNull({Elloree Offer Extended Ind})),",
				"     deleteIf(isNull({Elloree Hired Ind})),",
				"     deleteIf(isNull({Elloree Highest Stage})),",
				"     deleteIf(isNull({Elloree Exit Stage Group})),",
				"     deleteIf(isNull({Elloree Exit Type})),",
				"     deleteIf(isNull({Elloree Exit Driver})),",
				"     deleteIf(isNull({Elloree Exit Driver Group}))) ~> alterRow1",
				"alterRow1 select(mapColumn(",
				"          ClientId = {Client ID},",
				"          ClientEngagementDt = {Client Engagement Date},",
				"          ClientApplFinalDisp = {Client Applicant Final Disposition},",
				"          ClientApplStepBeforeFinalDisp = {Client Applicant Step Before Final Disposition},",
				"          ClientApplRejectedReason = {Client Applicant Rejected Reason},",
				"          ClientQualifiedInd = {Client Qualified Ind},",
				"          ClientSubmittedToHMInd = {Client Submitted to HM Ind},",
				"          ClientInterviewedInd = {Client Interviewed Ind},",
				"          ClientOfferExtendedInd = {Client Offer Extended Ind},",
				"          ClientHiredInd = {Client Hired Ind},",
				"          ElloreeApplFinalDisp = {Elloree Applicant Final Disposition},",
				"          ElloreeApplCategory = {Elloree Applicant Category},",
				"          ElloreeSubmittedtoMgrFl = {Elloree Submitted to Mgr Fl},",
				"          ElloreeQualified = {Elloree Qualified Ind},",
				"          ElloreeSubmitted = {Elloree Submitted to HM Ind},",
				"          ElloreeInterviewed = {Elloree Interviewed Ind},",
				"          ElloreeOfferExtended = {Elloree Offer Extended Ind},",
				"          ElloreeHired = {Elloree Hired Ind},",
				"          ElloreeHighestStage = {Elloree Highest Stage},",
				"          ElloreeExitStageGroup = {Elloree Exit Stage Group},",
				"          ElloreeExitType = {Elloree Exit Type},",
				"          ElloreeExitDriver = {Elloree Exit Driver},",
				"          ElloreeExitDriverGroup = {Elloree Exit Driver Group}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> AlterColumnNamesforMap",
				"AlterColumnNamesforMap derive(LoadDt = currentDate()) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ClientId as string,",
				"          ClientEngagementDt as date,",
				"          ClientApplFinalDisp as string,",
				"          ClientApplStepBeforeFinalDisp as string,",
				"          ClientApplRejectedReason as string,",
				"          ElloreeApplFinalDisp as string,",
				"          ElloreeApplCategory as string,",
				"          ElloreeSubmittedtoMgrFl as string,",
				"          LoadDt as date,",
				"          ClientQualifiedInd as string,",
				"          ClientSubmittedToHMInd as string,",
				"          ClientInterviewedInd as string,",
				"          ClientOfferExtendedInd as string,",
				"          ClientHiredInd as string,",
				"          ElloreeQualified as string,",
				"          ElloreeSubmitted as string,",
				"          ElloreeInterviewed as string,",
				"          ElloreeOfferExtended as string,",
				"          ElloreeHired as string,",
				"          ElloreeHighestStage as string,",
				"          ElloreeExitStageGroup as string,",
				"          ElloreeExitType as string,",
				"          ElloreeExitDriver as string,",
				"          ElloreeExitDriverGroup as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['ClientId','ClientEngagementDt','ClientApplFinalDisp','ClientApplStepBeforeFinalDisp','ClientApplRejectedReason','ClientQualifiedInd','ClientSubmittedToHMInd','ClientInterviewedInd','ClientOfferExtendedInd','ClientHiredInd'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}